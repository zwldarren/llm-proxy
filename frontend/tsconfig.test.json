{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"include": [
		"env.d.ts",
		"src/shims-vue.d.ts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/__tests__/*",
		"src/**/*.vue"
	],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"noImplicitAny": false,
		"types": ["vitest/globals", "node"]
	}
}
